<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Kolita en la calle</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Quicksand:wght@600;700&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.111.0/dist/umd/supabase.js" integrity="sha384-faMlYZUtkJj+Sh6Bmu/L0GzPcraRWN6CW+9RH3GUrK/Z0WS9tgaNNt0tHiLxsbdb" crossorigin="anonymous"></script>
<script src="js/kolita-auth.js"></script>
<script src="js/kolita-login.js"></script>
<style>
:root{
  --bg:#FBFCFA; --soft:#EDF2EA; --mid:#7C9877; --deep:#556F51; --ink:#3C4A3A; --mut:#93A28F;
  --line:#E4EAE1; --alert:#C87B5B; --orange:#E8813A;
  --ok:#2F7D4F; --maybe:#A87410; --no:#B3413A;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{font-family:'Nunito Sans',sans-serif;background:#F1F3EF;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:22px 16px 60px;color:var(--ink);}
.top{max-width:520px;width:100%;display:flex;align-items:center;gap:8px;margin-bottom:18px;}
.brand-k{width:32px;height:32px;flex-shrink:0;}
.brand-name{font-family:'Quicksand',sans-serif;font-weight:700;font-size:18px;}
.top button{margin-left:auto;background:none;border:none;font-size:12px;font-weight:800;color:var(--deep);cursor:pointer;font-family:inherit;}
.wrap{max-width:520px;width:100%;background:var(--bg);border:1px solid var(--line);border-radius:26px;padding:24px 20px;box-shadow:0 14px 40px rgba(70,85,66,.08);display:flex;flex-direction:column;gap:18px;}
.hide{display:none!important;}
h1{font-family:'Fraunces',serif;font-size:24px;font-weight:700;line-height:1.15;}
h1 span{color:var(--orange);}
h2{font-family:'Fraunces',serif;font-size:19px;font-weight:700;}
.sub{font-size:13px;color:var(--mut);font-weight:600;margin-top:4px;}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.stat{background:var(--soft);border-radius:14px;padding:10px 12px;}
.stat b{display:block;font-family:'Fraunces',serif;font-size:24px;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--deep);}
.stat small{font-size:11px;color:var(--mut);font-weight:700;line-height:1.3;display:block;}
.bar{height:5px;background:#fff;border-radius:9px;overflow:hidden;margin-top:6px;}
.bar i{display:block;height:100%;background:var(--mid);width:0;transition:width .3s;}
form{display:flex;flex-direction:column;gap:15px;}
.f{display:flex;flex-direction:column;gap:6px;min-width:0;}
.lbl{font-size:11px;font-weight:800;color:var(--deep);text-transform:uppercase;letter-spacing:.8px;}
.lbl em{font-style:normal;text-transform:none;letter-spacing:0;color:var(--mut);font-weight:600;}
.in{width:100%;padding:13px;border:1.5px solid var(--line);border-radius:13px;background:#fff;font-family:inherit;font-size:15px;color:var(--ink);outline:none;}
.in:focus{border-color:var(--mid);}
textarea.in{min-height:70px;resize:vertical;}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:430px){.row{grid-template-columns:1fr;}}
.chips{display:flex;flex-wrap:wrap;gap:8px;}
.chip{position:relative;}
.chip input{position:absolute;opacity:0;inset:0;}
.chip span{display:inline-block;padding:10px 14px;border-radius:99px;border:1.5px solid var(--line);background:#fff;font-weight:700;font-size:13.5px;cursor:pointer;}
.chip input:checked+span{background:var(--mid);border-color:var(--mid);color:#fff;}
.chip input:focus-visible+span{outline:3px solid #F3C9A6;}
.pitch{background:var(--soft);border-radius:13px;padding:11px 13px;font-size:13px;line-height:1.55;}
.pitch b{color:var(--orange);}
.carnet{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.lnk{font-size:13px;font-weight:800;color:var(--deep);}
.consent{display:flex;gap:10px;align-items:flex-start;font-size:12.5px;color:var(--mut);font-weight:600;line-height:1.55;}
.consent input{width:22px;height:22px;flex:none;accent-color:var(--mid);}
.btn{width:100%;padding:15px;border:none;border-radius:14px;font-family:inherit;font-size:15px;font-weight:800;cursor:pointer;background:var(--orange);color:#fff;}
.btn:disabled{opacity:.55;cursor:default;}
.msg{font-size:13px;font-weight:700;min-height:1.2em;}
.msg.err{color:var(--no);} .msg.ok{color:var(--ok);}
.lhead{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
.ghost{background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:8px 13px;font-family:inherit;font-weight:800;font-size:12.5px;color:var(--deep);cursor:pointer;}
.list{display:flex;flex-direction:column;gap:10px;}
.card{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:3px;min-width:0;}
.card .t{display:flex;justify-content:space-between;gap:8px;align-items:baseline;}
.card .n{font-weight:800;overflow-wrap:anywhere;}
.card .m{font-size:12.5px;color:var(--mut);font-weight:600;overflow-wrap:anywhere;}
.pill{font-size:11px;font-weight:800;padding:2px 9px;border-radius:99px;border:1.5px solid currentColor;white-space:nowrap;}
.p-si{color:var(--ok);} .p-tal{color:var(--maybe);} .p-no{color:var(--no);} .p-na{color:var(--mut);}
.del{align-self:flex-end;background:none;border:none;color:var(--mut);font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;}
.conf{display:flex;gap:8px;align-self:flex-end;}
.conf button{padding:6px 12px;font-size:12px;}
.danger{background:var(--no);color:#fff;border:none;border-radius:10px;font-weight:800;font-family:inherit;cursor:pointer;}
.empty{border:1.5px dashed var(--line);border-radius:14px;padding:18px;text-align:center;font-size:13px;color:var(--mut);font-weight:600;}
.denied{text-align:center;font-size:14px;color:var(--mut);font-weight:600;line-height:1.6;}
</style>
</head>
<body>
<div class="top">
  <svg class="brand-k" viewBox="0 0 92 92"><rect x="2" y="2" width="88" height="88" rx="24" fill="#7C9877"/><path d="M32 24 L32 68" stroke="#FBFCFA" stroke-width="9" stroke-linecap="round"/><path d="M34 48 C 48 46, 58 36, 56 24" fill="none" stroke="#FBFCFA" stroke-width="9" stroke-linecap="round"/><path d="M34 48 C 48 52, 58 60, 62 70" fill="none" stroke="#DCE8D8" stroke-width="9" stroke-linecap="round"/></svg>
  <span class="brand-name">kolita</span>
  <button type="button" id="salir" class="hide">Salir</button>
</div>

<div class="wrap" id="cajaLogin"></div>

<div class="wrap hide" id="cajaNo">
  <p class="denied">Esta página es solo para el equipo Kolita.<br>Si eres del equipo, entra con el correo registrado.</p>
</div>

<div class="wrap hide" id="cajaApp">
  <div>
    <h1>Kolita <span>en la calle</span></h1>
    <p class="sub">Registra cada visita en 1 minuto, antes de seguir a la siguiente.</p>
  </div>

  <div class="stats">
    <div class="stat"><b id="sTot">0</b><small>contactos · meta 20</small><div class="bar"><i id="bTot"></i></div></div>
    <div class="stat"><b id="sPag">0</b><small>pagarían · meta 5</small><div class="bar"><i id="bPag"></i></div></div>
    <div class="stat"><b id="sCar">0</b><small>carnets creados</small></div>
  </div>

  <form id="f" novalidate>
    <div class="f">
      <span class="lbl">¿Con quién hablaste?</span>
      <div class="chips">
        <label class="chip"><input type="radio" name="tipo" value="Propietario"><span>Propietario</span></label>
        <label class="chip"><input type="radio" name="tipo" value="Paseador"><span>Paseador</span></label>
        <label class="chip"><input type="radio" name="tipo" value="Veterinario independiente"><span>Vet independiente</span></label>
        <label class="chip"><input type="radio" name="tipo" value="Veterinaria"><span>Veterinaria</span></label>
        <label class="chip"><input type="radio" name="tipo" value="Otro"><span>Otro</span></label>
      </div>
      <div class="pitch" id="pitch">Elige un tipo y te recuerdo la frase clave.</div>
    </div>

    <div class="row">
      <div class="f"><label class="lbl" for="nombre">Nombre</label><input class="in" id="nombre" autocomplete="off"></div>
      <div class="f"><label class="lbl" for="negocio">Negocio <em>(si aplica)</em></label><input class="in" id="negocio" autocomplete="off"></div>
    </div>
    <div class="row">
      <div class="f"><label class="lbl" for="correo">Correo</label><input class="in" type="email" id="correo" inputmode="email" autocomplete="off"></div>
      <div class="f"><label class="lbl" for="whatsapp">WhatsApp</label><input class="in" type="tel" id="whatsapp" inputmode="tel" autocomplete="off"></div>
    </div>
    <div class="row">
      <div class="f"><label class="lbl" for="zona">Zona / barrio</label><input class="in" id="zona" placeholder="Ej. Laureles"></div>
      <div class="f"><label class="lbl" for="perros">Perros por semana</label><input class="in" type="number" id="perros" inputmode="numeric" min="0"></div>
    </div>

    <div class="f">
      <span class="lbl">¿Pagaría $29.900/mes? <em>(solo proveedores)</em></span>
      <div class="chips">
        <label class="chip"><input type="radio" name="paga" value="Sí"><span>Sí</span></label>
        <label class="chip"><input type="radio" name="paga" value="Tal vez"><span>Tal vez</span></label>
        <label class="chip"><input type="radio" name="paga" value="No"><span>No</span></label>
        <label class="chip"><input type="radio" name="paga" value="No aplica"><span>No aplica</span></label>
      </div>
    </div>

    <div class="f">
      <div class="carnet">
        <span class="lbl">¿Creó el carnet digital?</span>
        <a class="lnk" href="registro.html" target="_blank" rel="noopener">Abrir registro de carnet ↗</a>
      </div>
      <div class="chips">
        <label class="chip"><input type="radio" name="carnet" value="si"><span>Sí</span></label>
        <label class="chip"><input type="radio" name="carnet" value="no"><span>No</span></label>
      </div>
    </div>

    <div class="f"><label class="lbl" for="notas">Notas <em>(objeciones, cuándo volver)</em></label><textarea class="in" id="notas"></textarea></div>

    <label class="consent"><input type="checkbox" id="autoriza"><span>La persona autoriza a Kolita a guardar sus datos y enviarle novedades por correo y WhatsApp (Ley 1581 de 2012). Puede pedir que los borremos cuando quiera.</span></label>

    <button class="btn" type="submit" id="guardar">Guardar contacto</button>
    <p class="msg" id="msg" role="status"></p>
  </form>

  <div class="lhead">
    <h2>Contactos</h2>
    <button class="ghost hide" type="button" id="exportar">Descargar Excel (CSV)</button>
  </div>
  <div class="list" id="list"><div class="empty">Aquí aparecerán tus contactos.</div></div>
</div>

<script>
(function(){
  'use strict';
  var A = window.KolitaAuth;
  var cli = A && A.client;
  var $ = function(id){ return document.getElementById(id); };
  var filas = [];

  var PITCH = {
    'Propietario': '<b>Frase clave:</b> Si se pierde, te avisan sin exponer tu número. Crea el carnet ahí mismo y pide el correo.',
    'Paseador': '<b>Frase clave:</b> Las familias confían más en un paseador con perros identificados y reseñas.',
    'Veterinario independiente': '<b>Frase clave:</b> Las familias de tu zona te van a encontrar y dejar reseñas.',
    'Veterinaria': '<b>Frase clave:</b> Tus clientes reciben recordatorio de vacunas y vuelven a tu clínica. Pide el contacto del dueño o administrador.',
    'Otro': '<b>Mensaje base:</b> Carnet digital gratis con QR: vacunas, desparasitación y alerta si se pierde, sin exponer el número de la familia.'
  };

  function ver(id){ ['cajaLogin','cajaNo','cajaApp'].forEach(function(x){ $(x).classList.toggle('hide', x !== id); }); }
  function msg(t, c){ var m = $('msg'); m.textContent = t; m.className = 'msg ' + (c || ''); }
  function marcado(n){ var r = document.querySelector('input[name="'+n+'"]:checked'); return r ? r.value : ''; }
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

  document.querySelectorAll('input[name="tipo"]').forEach(function(r){
    r.addEventListener('change', function(){ $('pitch').innerHTML = PITCH[r.value]; });
  });

  function pinta(){
    var tot = filas.length;
    var pag = filas.filter(function(r){ return r.pagaria === 'Sí' || r.pagaria === 'Tal vez'; }).length;
    var car = filas.filter(function(r){ return r.creo_carnet === true; }).length;
    $('sTot').textContent = tot; $('sPag').textContent = pag; $('sCar').textContent = car;
    $('bTot').style.width = Math.min(100, tot/20*100) + '%';
    $('bPag').style.width = Math.min(100, pag/5*100) + '%';
    $('exportar').classList.toggle('hide', !tot);
    if(!tot){ $('list').innerHTML = '<div class="empty">Aquí aparecerán tus contactos. Guarda el primero arriba.</div>'; return; }
    $('list').innerHTML = filas.map(function(r){
      var f = new Date(r.creado_en).toLocaleDateString('es-CO', {day:'numeric', month:'short'});
      var cls = {'Sí':'p-si','Tal vez':'p-tal','No':'p-no'}[r.pagaria] || 'p-na';
      var pill = r.tipo === 'Propietario' ? '' : '<span class="pill '+cls+'">'+(r.pagaria ? 'Paga: '+esc(r.pagaria) : 'Sin respuesta')+'</span>';
      return '<div class="card">' +
        '<div class="t"><span class="n">'+esc(r.nombre)+(r.negocio ? ' · '+esc(r.negocio) : '')+'</span>'+pill+'</div>' +
        '<div class="m">'+esc(r.tipo)+(r.zona ? ' · '+esc(r.zona) : '')+' · '+f+(r.perros_semana != null ? ' · '+r.perros_semana+' perros/sem' : '')+'</div>' +
        '<div class="m">'+esc(r.correo || 'sin correo')+(r.whatsapp ? ' · '+esc(r.whatsapp) : '')+(r.creo_carnet ? ' · carnet creado' : '')+'</div>' +
        (r.notas ? '<div class="m">'+esc(r.notas)+'</div>' : '') +
        '<button class="del" type="button" data-del="'+esc(r.id)+'">Borrar</button>' +
      '</div>';
    }).join('');
  }

  async function carga(){
    var r = await cli.from('contactos_campo').select('*').order('creado_en', {ascending:false});
    if(r.error){ msg('No pude cargar los contactos. Revisa tu internet.', 'err'); return; }
    filas = r.data || []; pinta();
  }

  $('list').addEventListener('click', async function(e){
    var d = e.target.dataset;
    if(d.del){ e.target.outerHTML = '<div class="conf"><button class="ghost" type="button" data-no="1">Cancelar</button><button class="danger" type="button" data-si="'+d.del+'">Sí, borrar</button></div>'; return; }
    if(d.no){ pinta(); return; }
    if(d.si){
      var r = await cli.from('contactos_campo').delete().eq('id', d.si);
      if(r.error){ msg('No se pudo borrar. Intenta otra vez.', 'err'); return; }
      filas = filas.filter(function(x){ return x.id !== d.si; }); pinta();
    }
  });

  $('f').addEventListener('submit', async function(e){
    e.preventDefault();
    var correo = $('correo').value.trim().toLowerCase();
    var fila = {
      tipo: marcado('tipo'),
      nombre: $('nombre').value.trim(),
      negocio: $('negocio').value.trim() || null,
      correo: correo || null,
      whatsapp: $('whatsapp').value.trim() || null,
      zona: $('zona').value.trim() || null,
      perros_semana: $('perros').value === '' ? null : parseInt($('perros').value, 10),
      pagaria: marcado('paga') || null,
      creo_carnet: marcado('carnet') === '' ? null : marcado('carnet') === 'si',
      notas: $('notas').value.trim() || null,
      autoriza_datos: $('autoriza').checked
    };
    if(!fila.tipo) return msg('Elige con quién hablaste.', 'err');
    if(!fila.nombre) return msg('Escribe el nombre.', 'err');
    if(!fila.correo && !fila.whatsapp) return msg('Necesitas al menos correo o WhatsApp.', 'err');
    if(fila.correo && !A.correoValido(fila.correo)) return msg('Revisa el correo, parece incompleto.', 'err');
    if(!fila.autoriza_datos) return msg('Marca la autorización de datos antes de guardar.', 'err');
    $('guardar').disabled = true;
    var r = await cli.from('contactos_campo').insert(fila).select().single();
    $('guardar').disabled = false;
    if(r.error){ msg('No se guardó. Revisa tu internet e intenta otra vez.', 'err'); return; }
    filas.unshift(r.data); pinta();
    $('f').reset(); $('pitch').textContent = 'Elige un tipo y te recuerdo la frase clave.';
    msg('Guardado. ¡Siguiente visita!', 'ok');
    window.scrollTo({top:0, behavior:'smooth'});
  });

  $('exportar').addEventListener('click', function(){
    var cols = ['creado_en','tipo','nombre','negocio','correo','whatsapp','zona','perros_semana','pagaria','creo_carnet','autoriza_datos','notas'];
    var q = function(v){ if(v === true) v = 'Sí'; if(v === false) v = 'No'; return '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"'; };
    var csv = '﻿' + cols.join(';') + '\n' + filas.map(function(r){ return cols.map(function(c){ return q(r[c]); }).join(';'); }).join('\n');
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv;charset=utf-8'}));
    a.download = 'kolita-contactos-' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a); a.click(); a.remove();
  });

  $('salir').addEventListener('click', async function(){ await A.salir(); location.reload(); });

  async function entrar(){
    $('salir').classList.remove('hide');
    var r = await cli.rpc('es_admin_kolita');
    if(r.error || r.data !== true){ ver('cajaNo'); return; }
    ver('cajaApp'); carga();
  }

  async function inicio(){
    if(!cli){ $('cajaLogin').innerHTML = '<p class="denied">No cargó la conexión. Recarga la página.</p>'; return; }
    var s = await A.sesionActual();
    if(s){ entrar(); return; }
    KolitaLogin.montar($('cajaLogin'), {
      titulo: 'Equipo Kolita',
      subtitulo: 'Entra con tu correo para registrar visitas.',
      crearSiNoExiste: false,
      alEntrar: entrar
    });
  }
  inicio();
})();
</script>
</body>
</html>
